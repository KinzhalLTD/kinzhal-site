{
  "name": "aeloria",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "setup": "npx expo install react-native-webview react-native-google-mobile-ads expo-tracking-transparency expo-constants expo-status-bar && npm install react-native-iap@^12.15.0 && npx expo install --fix",
    "postinstall": "node scripts/build-game.js",
    "build:game": "node scripts/build-game.js",
    "sync:game": "node scripts/sync-game.js && node scripts/build-game.js",
    "check:store": "node scripts/check-store-ready.js"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-tracking-transparency": "~6.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-google-mobile-ads": "^15.4.0",
    "react-native-iap": "^12.15.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0"
  }
}
